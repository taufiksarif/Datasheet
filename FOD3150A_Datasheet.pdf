         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">FOD3150A - Gate Drive Optocoupler, 2.5 A Output Current, High Noise Immunity</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>ON Semiconductor</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The FOD3150A is a 2.5 A Output Current Gate Drive Optocoupler,&#xA;capable of driving most 800 V / 20 A IGBTs or MOSFETs. It is ideally&#xA;suited for fast switching driving of power IGBTs and MOSFETs used&#xA;in motor control inverter applications, and high performance power system.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <pdf:Producer>Acrobat Distiller 20.0 (Windows)</pdf:Producer>
         <pdf:Keywords/>
         <xmpMM:DocumentID>uuid:387047ea-6184-4519-ae0f-84a9aa41a9e2</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:27692eff-b00a-462f-9685-04ec0005950e</xmpMM:InstanceID>
      </rdf:Description>
   </rdf:RDF>
