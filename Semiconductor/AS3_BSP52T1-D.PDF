         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">BSP52T1 - NPN Small-Signal Darlington Transistor</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>s2190c</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">This NPN small signal Darlington transistor is designed for use in&#xD;&#xA;switching applications, such as print hammer, relay, solenoid and lamp&#xD;&#xA;drivers. The device is housed in the SOT-223 package, which is&#xD;&#xA;designed for medium power surface mount applications.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:3fc9b527-6c37-4317-996f-dd579c3c6ea6</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:6355b0e6-b29b-4944-9ccd-d44027bc7178</xmpMM:InstanceID>
         <illustrator:StartupProfile>Print</illustrator:StartupProfile>
      </rdf:Description>
   </rdf:RDF>
